create table calories(
kalorid int,
toiduaine_id int
FOREIGN key (toiduaine_id) REFERENCES toiduaine(toiduaine_id),
yhik_id int,
FOREIGN key (yhik_id) REFERENCES yhik(yhik_id));

CREATE PROCEDURE addcalory
@newcalory int,
@toiduaineid varchar (30),
@yhikid int
AS
BEGIN
    INSERT INTO calories(kalorid, toiduaine_id, yhik_id)
    VALUES (@newcalory, @toiduaineid, @yhikid);
    SELECT * FROM calories;
END;

EXEC addcalory 100,3,6;

Create procedure deletecaloryid
@idtodelete int
AS
BEGIN
	DELETE FROM calories Where toiduaine_id = @idtodelete;
	SELECT * FROM calories;
END;

