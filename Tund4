-- =============================================
-- 4. Procedure: Show products with price greater than input
-- =============================================
CREATE PROCEDURE suuremHind
    @hind int
AS
BEGIN
    SELECT * FROM products
    WHERE list_price > @hind;
END;
GO

-- Test
EXEC suuremHind 1000;
GO

-- =============================================
-- 5. Procedure: Get MIN and MAX prices using OUTPUT parameters
-- =============================================
CREATE PROCEDURE minmaxHIND
    @minHIND MONEY OUTPUT,
    @maxHIND MONEY OUTPUT
AS
BEGIN
    SELECT
        @minHIND = MIN(list_price),
        @maxHIND = MAX(list_price)
    FROM products;
END;
GO

-- Test OUTPUT parameters
DECLARE @minHind MONEY, @maxHind MONEY;

EXEC minmaxHIND @minHind OUTPUT, @maxHind OUTPUT;

PRINT 'Min hind = ' + CONVERT(varchar, @minHind);
PRINT 'Max hind = ' + CONVERT(varchar, @maxHind);
GO

-- =============================================
-- 6. Universal procedure to modify table structure
-- =============================================
CREATE PROCEDURE muudatus
    @tegevus varchar(10),      -- 'add' or 'drop'
    @tabelinimi varchar(50),   -- table name
    @veerunimi varchar(50),    -- column name
    @tyyp varchar(50) = NULL   -- data type (required for 'add')
AS
BEGIN
    DECLARE @sqltegevus nvarchar(4000);
    
    SET @sqltegevus = CASE
        WHEN @tegevus = 'add' THEN
            CONCAT('ALTER TABLE ', @tabelinimi, ' ADD ', @veerunimi, ' ', @tyyp)
        WHEN @tegevus = 'drop' THEN
            CONCAT('ALTER TABLE ', @tabelinimi, ' DROP COLUMN ', @veerunimi)
        ELSE
            NULL
    END;
    
    IF @sqltegevus IS NOT NULL
    BEGIN
        PRINT @sqltegevus;
        EXEC sp_executesql @sqltegevus;
    END
    ELSE
    BEGIN
        PRINT 'Invalid operation. Use ''add'' or ''drop''.';
    END
END;
GO

-- Test add column
EXEC muudatus 'add', 'categories', 'testVeerg', 'int';
GO

