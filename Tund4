CREATE TABLE categories(
    category_id int PRIMARY KEY IDENTITY(1,1),
    category_name varchar(25)
);


INSERT INTO categories(category_name)
VALUES ('Arvutit');


SELECT * FROM categories;


CREATE PROCEDURE lisaKategooria
    @uusKategooria varchar(30)
AS
BEGIN
    INSERT INTO categories(category_name)
    VALUES (@uusKategooria);
    SELECT * FROM categories;
END;
GO

-- Test the procedure
EXEC lisaKategooria 'Auto';


SELECT * FROM categories;


CREATE PROCEDURE kustutaKategooria
    @kustutaId int
AS
BEGIN
    SELECT * FROM categories;
    DELETE FROM categories WHERE category_id = @kustutaId;
    SELECT * FROM categories;
END;


-- =============================================
-- Procedure: Search categories by first letter
-- =============================================
CREATE PROCEDURE otsing1taht
    @taht char(1)
AS
BEGIN
    SELECT * FROM categories
    WHERE category_name LIKE @taht + '%';
END;



EXEC otsing1taht 'A';


