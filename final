Create view mangudjameeskonnad
AS
Select MangNimi, KyberRyhmNimi
FROM Mang
Inner join KyberSport
on Mang.MangID = Kybersport.MangID

select * from mangudjameeskonnad

Create view mangudjaryhmadjaosalejad
AS
select MangNimi, KyberRyhmNimi, OsalejaNimi
FROM Mang
Inner join KyberSport
	on Mang.MangID = KyberSport.MangID
Inner join KyberOsaleja 
	on KyberSport.KyberSportID = KyberOsaleja.KyberSportID;

select * from mangudjaryhmadjaosalejad

