drop view meeskondkoosseis
CREATE VIEW meeskondkoosseis
AS
SELECT KyberRyhmNimi, OsalejaNimi
FROM KyberSport
Inner join KyberOsaleja
on Kybersport.KyberSportID = KyberOsaleja.KyberSportID

