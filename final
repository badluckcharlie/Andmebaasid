Create procedure otsingOsaleja
@taht char(1)
AS
BEGIN
	Select * From KyberOsaleja
	where OsalejaNimi LIKE @taht + '%';
END

EXEC otsingOsaleja 'J';

CREATE PROCEDURE lisaOsaleja
    @uusKyberOsaleja varchar(50),
	@uusKyberVanus int,
	@uusKyberSportID int
AS
BEGIN
    INSERT INTO KyberOsaleja(OsalejaNimi, Vanus, KyberSportID)
    VALUES (@uusKyberOsaleja, @uusKyberVanus, @uusKyberSportID);
    SELECT * FROM KyberOsaleja;
END;

exec lisaOsaleja 'Lawrence Queens', 19, 1

create procedure deleteOsaleja
	@kustutanimi varchar (50)
as
begin
	DELETE from KyberOsaleja where OsalejaNimi = @kustutanimi
	Select * from KyberOsaleja
END;

exec deleteOsaleja 'Lawrence Queens'

