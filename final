Drop trigger kustutaKyberSport
Create trigger kustutaKyberSport
on KyberSport
FOR DELETE
AS
INSERT INTO logi(kuupaev, kasutaja, toiming, andmed)
select
GETDATE(),
SYSTEM_USER,
'on tehtud DELETE käsk',
concat('Ryhm: ', deleted.KyberRyhmNimi, ' ID: ', deleted.KyberSportID, ' Mäng: ', Mang.MangNimi)
from deleted
inner join Mang
on deleted.MangID = Mang.MangID

Drop trigger lisaKyberSport
Create trigger lisaKyberSport
on KyberSport
FOR INSERT
AS
INSERT INTO logi(kuupaev, kasutaja, toiming, andmed)
select
GETDATE(),
SYSTEM_USER,
'on tehtud INSERT käsk',
concat('Ryhm: ', inserted.KyberRyhmNimi, 'ID: ', inserted.KyberSportID, ' Mäng: ', Mang.MangNimi)
from inserted
inner join Mang
on inserted.MangID = Mang.MangID

