-- Таблица order_items (исправлен порядок - products уже существует)
CREATE TABLE order_items(
    order_id int,
    FOREIGN KEY (order_id) REFERENCES orders(order_id),
    item_id int PRIMARY KEY IDENTITY(1,1),
    product_id int,
    FOREIGN KEY (product_id) REFERENCES products(product_id),
    quantity int,  -- Изменено с Varchar на int
    list_price decimal(10,2),  -- Изменено на DECIMAL
    discount decimal(5,2)  -- Изменено с Varchar(4) на DECIMAL для процентов скидки
