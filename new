-- Таблица staffs (исправлен тип данных manager_id)
CREATE TABLE staffs(
    staff_id int PRIMARY KEY IDENTITY(1,1),
    first_name Varchar(20),
    last_name Varchar(20),
    phone Varchar(25),
    email Varchar(30),
    active Varchar(10),
    store_id int,
    FOREIGN KEY (store_id) REFERENCES stores(store_id),
    manager_id int  -- Изменено с Varchar(10) на int, т.к. ссылается на staff_id
)

