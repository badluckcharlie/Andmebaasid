-- Таблица products (исправлен порядок - brands уже существует)
CREATE TABLE products(
    product_id int PRIMARY KEY IDENTITY(1,1),
    product_name varchar(30),  -- Увеличено с 20 до 30
    brand_id int,
    category_id int,
    FOREIGN KEY (brand_id) REFERENCES brands(brand_id),
    FOREIGN KEY (category_id) REFERENCES categories(category_id),
    model_year varchar(4),
    list_price decimal(10,2)  -- Изменено на DECIMAL для хранения валюты
)

