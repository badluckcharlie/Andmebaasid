-- Таблица orders (исправлен порядок - staffs уже существует)
CREATE TABLE orders(
    order_id int PRIMARY KEY IDENTITY(1,1),
    customer_id int,
    FOREIGN KEY (customer_id) REFERENCES customers(customer_id),
    order_status varchar(20),  -- Увеличено с 10 до 20
    order_date date,
    required_date date,
    shipped_date date,
    store_id int,
    staff_id int,
    currency_code char(3),  -- Добавлена валюта
    FOREIGN KEY (store_id) REFERENCES stores(store_id),
    FOREIGN KEY (staff_id) REFERENCES staffs(staff_id)
)

